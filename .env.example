# ── Claude API ────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Email (Gmail recommended) ─────────────────────────────────
# Where results get sent
EMAIL_TO=drew110321@gmail.com

# The Gmail account that sends the email
EMAIL_FROM=your_sender_gmail@gmail.com

# Gmail App Password (NOT your normal password).
# Enable 2FA → Google Account → Security → App Passwords → generate one.
EMAIL_PASSWORD=your_16_char_app_password

# Optional — only change if not using Gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# ── iPhone server auth ────────────────────────────────────────
# Make up any long random password — paste it here AND in your iOS Shortcut
SERVER_API_KEY=make-up-a-long-random-password-here
